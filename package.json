{
  "name": "musiccube",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "MusicCube: a tiny floating cube music player",
  "author": "madwind",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "test": "node --test test/*.test.cjs",
    "start": "electron .",
    "start:dev": "electron . --dev"
  },
  "build": {
    "appId": "com.madwind.musiccube",
    "productName": "MusicCube",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/*.cjs",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "lucide": "^1.71.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
